# Copiar como backend/.env y completar los valores del entorno.
APP_NAME=Asiscontrol
LEGAL_ENTITY_NAME=Creamox SAS
APP_ENV=production
APP_DEBUG=0
APP_URL=https://app.example.com
SESSION_NAME=asiscontrol_session
FORCE_HTTPS=1
SECURE_COOKIES=1
COOKIE_SAMESITE=Lax
# Cierre automático por inactividad (segundos).
SESSION_IDLE_TIMEOUT=1800

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vzwquesv_app
DB_USER=vzwquesv_app
DB_PASS=

# SMTP es opcional mientras se define el proveedor final.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Asiscontrol
SMTP_DEBUG=0

BACKUP_SCHEDULE=monthly
BACKUP_RETENTION_DAYS=365
BACKUP_DIR=/var/www/asiscontrol/backend/storage/backups
BACKUP_ENCRYPTION_REQUIRED=0
# Obligatoria solo si BACKUP_ENCRYPTION_REQUIRED=1. Nunca la publiques ni la guardes en el repositorio.
BACKUP_ENCRYPTION_KEY=

DEFAULT_GEOFENCE_RADIUS_M=150
# review = registra alerta para revisión; block = rechaza fuera de zona.
GEOFENCE_ENFORCEMENT=review

# Opcional: agente local firmado para puestos Windows.
SECUGEN_WEBAPI_URL=http://127.0.0.1:9876
